{
  "name": "renderfarm-companion",
  "version": "1.0.24",
  "description": "Renderfarm desktop companion app",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "launch": "node launch.cjs",
    "dist": "electron-vite build && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.25",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.2"
  },
  "build": {
    "appId": "com.renderfarm.companion",
    "productName": "Renderfarm",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "Silasshaibu",
      "repo": "renderfarm-companion"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
